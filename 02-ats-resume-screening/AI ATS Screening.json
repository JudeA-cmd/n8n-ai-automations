    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst r = JSON.parse(raw.replace(/```json|```/g, '').trim());\nconst app = $('On form submission').first().json;\nconst now = $now.setZone('Africa/Lagos');\n\nreturn [{ json: {\n  Date: now.toFormat('yyyy-LL-dd HH:mm'),\n  Name: app['Full Name'],\n  Email: app.Email,\n  Position: app.Position,\n  Score: Number(r.score) || 0,\n  Recommendation: r.recommendation,\n  ExperienceYears: Number(r.experience_years) || 0,\n  MatchedSkills: (r.matched_skills || []).join(', '),\n  MissingSkills: (r.missing_skills || []).join(', '),\n  RedFlags: (r.red_flags || []).join(', '),\n  Summary: r.summary || ''\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
