      "name": "AI Classify",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "googlePalmApi": {
          "id": "W38WETF6TGvoHCXP",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const VALID = ['Sales','Support','Billing','Partnerships','Jobs','Others'];\nconst src = $('Prepare Email').first().json;\nconst item = $input.first().json;\n\nlet r = {};\nlet parseError = '';\ntry {\n  const raw = item.candidates[0].content.parts[0].text;\n  r = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  parseError = 'AI returned unparseable output: ' + e.message;\n}\n\nconst category = VALID.includes(r.category) ? r.category : 'Others';\nconst priority = ['High','Medium','Low'].includes(r.priority) ? r.priority : 'Medium';\nconst confidence = Number(r.confidence);\nconst needsReview = Boolean(r.needs_review) || !(confidence >= 0.6) || !VALID.includes(r.category) || !!parseError;\n\nreturn [{ json: {\n  emailId: src.emailId,\n  threadId: src.threadId,\n  from: src.from,\n  subject: src.subject,\n  category, priority,\n  confidence: isNaN(confidence) ? 0 : confidence,\n  needsReview,\n  summary: r.summary || parseError || 'No summary produced.',\n  draftReply: r.draft_reply || '',\n  reviewReason: parseError || (!(confidence >= 0.6) ? 'Low confidence' : (r.needs_review ? 'Model flagged for review' : ''))\n} }];"
      },
